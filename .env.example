# WealthCore — environment configuration
# Copy to `.env` (not committed) and fill in. Never commit real secrets.

# Runtime ---------------------------------------------------------------
NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# Database --------------------------------------------------------------
# Development default is ./data/wealthcore.db (SQLite). For PostgreSQL in
# production the repository layer is supported via WEALTHCORE_DB_URL.
WEALTHCORE_DB=data/wealthcore.db
# WEALTHCORE_DB_URL=postgres://user:pass@host:5432/wealthcore

# Sessions / cookies -----------------------------------------------------
WEALTHCORE_SESSION_SECRET=change-me-to-a-long-random-string-32plus
WEALTHCORE_SESSION_TTL_HOURS=12
WEALTHCORE_COOKIE_SECURE=false
WEALTHCORE_COOKIE_SAMESITE=lax

# Encryption (app lock / sensitive at-rest fields) ----------------------
WEALTHCORE_ENCRYPTION_KEY=change-me-to-a-long-random-string-32plus

# Login rate limiting ----------------------------------------------------
WEALTHCORE_LOGIN_RATE_MAX=10
WEALTHCORE_LOGIN_RATE_WINDOW_MINUTES=15

# AA / FIU integration ----------------------------------------------------
# Provider selection: mock (default), finvu, setu, onemoney, anumati, ink,
# saafe, nadl, protean. `mock` needs NO credentials and runs fully locally.
# For a real provider, supply the required credentials below.
AA_PROVIDER=mock
WEALTHCORE_AA_PROVIDER=
WEALTHCORE_AA_CLIENT_ID=
WEALTHCORE_AA_SECRET=
WEALTHCORE_AA_BASE_URL=

# Finvu (JWS + ECDH/AES-GCM — see docs/AA_IMPLEMENTATION.md, PENDING CONFIRMATION)
WEALTHCORE_AA_CLIENT_API_KEY=
WEALTHCORE_AA_SIGNING_PRIVATE_KEY=
WEALTHCORE_AA_SIGNING_PUBLIC_KEY=
WEALTHCORE_AA_KID=

# Setu (AA gateway) — CURRENT OFFICIAL AUTH MODEL.
# The Setu Bridge provides client_id + client_secret + x-product-instance-id.
# These client credentials are used to ACQUIRE an access token (Setu Auth
# Mechanism / getToken). The access token is then sent as:
#     Authorization: Bearer <access_token>
# plus:
#     x-product-instance-id: <product-instance-id>
# The client secret is NEVER sent as a request header on the AA APIs.
# Sandbox: https://fiu-sandbox.setu.co ; Production: https://fiu.setu.co
# AA_ENVIRONMENT must be `production` to use production (never silently fall back).
AA_ENVIRONMENT=sandbox
SETU_ENVIRONMENT=sandbox
WEALTHCORE_SETU_CLIENT_ID=
WEALTHCORE_SETU_CLIENT_SECRET=
WEALTHCORE_SETU_PRODUCT_INSTANCE_ID=
# Override the token endpoint / a legacy short-lived access token (optional).
# WEALTHCORE_SETU_TOKEN_URL=
WEALTHCORE_SETU_TOKEN=
WEALTHCORE_SETU_BASE_URL=https://fiu-sandbox.setu.co
WEALTHCORE_SETU_WEBHOOK_SECRET=
WEALTHCORE_SETU_SIGNING_PUBLIC_KEY=

# Market data provider ----------------------------------------------------
WEALTHCORE_MARKET_PROVIDER=
WEALTHCORE_MARKET_API_KEY=
WEALTHCORE_MARKET_BASE_URL=

# LLM / AI provider -------------------------------------------------------
WEALTHCORE_LLM_PROVIDER=
WEALTHCORE_LLM_API_KEY=
WEALTHCORE_LLM_BASE_URL=
WEALTHCORE_LLM_MODEL=

# Background scheduler ----------------------------------------------------
WEALTHCORE_SCHEDULER_ENABLED=true
WEALTHCORE_SCHEDULER_INTERVAL_SECONDS=60
WEALTHCORE_MARKET_REFRESH_MINUTES=60

# Logging -----------------------------------------------------------------
WEALTHCORE_LOG_LEVEL=debug
WEALTHCORE_LOG_JSON=false
